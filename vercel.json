{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/music/(.*).opus",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/ogg"
        }
      ]
    },
    {
      "source": "/music/(.*).m4a",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        }
      ]
    }
  ]
}
