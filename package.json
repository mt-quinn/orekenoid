{
  "name": "orekenoid",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "worldmap": "vite --host 127.0.0.1 --port 8080 --open /worldmap.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "test": "vitest run",
    "test:browser": "playwright test",
    "rooms": "node tools/drawrooms.mjs && node tools/roomkit.mjs check && node tools/roomkit.mjs build",
    "rooms:palette": "node tools/roomkit.mjs palette",
    "rooms:preview": "node tools/roomkit.mjs preview",
    "rooms:ascii": "node tools/roomkit.mjs ascii",
    "rooms:profile": "node tools/roomkit.mjs profile"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "latest",
    "pixi.js": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
